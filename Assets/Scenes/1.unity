  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sinh 1950, qu\xEA Ti\xEAn L\u1EEF, H\u01B0ng Y\xEAn, l\xE0 Ch\xEDnh tr\u1ECB vi\xEAn ph\xF3 \u0110\u1EA1i \u0111\u1ED9i 1, Ti\u1EC3u \u0111o\xE0n 1, Trung \u0111o\xE0n 567, b\u1ED9 \u0111\u1ED9i \u0111\u1ECBa ph\u01B0\u01A1ng t\u1EC9nh Cao B\u1EB1ng, \u0111\u1ED3ng ch\xED \u0111\xE3 m\u01B0u tr\xED, d\u0169ng c\u1EA3m ch\u1EC9 huy \u0111\u01A1n v\u1ECB chi\u1EBFn \u0111\u1EA5u \u0111\u1EA9y l\xF9i nhi\u1EC1u \u0111\u1EE3t ti\u1EBFn c\xF4ng c\u1EE7a qu\xE2n Trung Qu\u1ED1c, gi\u1EEF v\u1EEFng tr\u1EADn \u0111\u1ECBa. Phong t\u1EB7ng Anh h\xF9ng l\u1EF1c l\u01B0\u1EE3ng v\u0169 trang nh\xE2n d\xE2n n\u0103m 1979.\n\nBorn in 1950, he was a native of Tien Lu District, Hung Yen Province; As deputy political officer of Company 1, Battalion 1, Regiment 567, local soldiers of Cao Bang Province, he cleverly and courageously commanded his unit in combat to repel many attacks by Chinese troops, firmly holding the battlefield. He was awarded the title \"Hero of People's Armed Forces\" in 1979."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
