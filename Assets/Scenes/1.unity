  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Qu\xEA Ho\u1EB1ng H\xF3a, Thanh H\xF3a, l\xE0 Th\u01B0\u1EE3ng s\u0129 C\xF4ng an nh\xE2n d\xE2n v\u0169 trang (B\u1ED9 \u0111\u1ED9i Bi\xEAn ph\xF2ng). Ng\xE0y 25/8/1978, \u0111\u1ED3ng ch\xED hy sinh t\u1EA1i x\xE3 H\u1ED3ng Phong, huy\u1EC7n Cao L\u1ED9c, t\u1EC9nh L\u1EA1ng S\u01A1n, khi b\u1EA3o v\u1EC7 nh\xE2n d\xE2n tr\u01B0\u1EDBc qu\xE2n Trung Qu\u1ED1c. Truy t\u1EB7ng Anh h\xF9ng l\u1EF1c l\u01B0\u1EE3ng v\u0169 trang nh\xE2n d\xE2n n\u0103m 1978.\n\nA native of Hoang Hoa District, Thanh Hoa Province, he was a Sergeant of the People's Armed Police (Border Guard). On August 25, 1978, he died in Hong Phong Commune, Cao Loc Distric, Lang Son Province, while protecting the people against Chinese troops. He was posthumously awarded the title \"Hero of People's Armed Forces\" in 1978."
  m_isRightToLeft: 0
