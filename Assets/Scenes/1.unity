  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=24><b>Ch\u1ED1ng l\u1EA5n chi\u1EBFm bi\xEAn gi\u1EDBi,\r\n4/1979 -9/1989</b></size>\r\n\r\n<size=16><b>Resisting border invasion, April\r\n1979-September 1989</b></size>\r\n\r\n<size=13>Th\u1EA5t b\u1EA1i trong cu\u1ED9c chi\u1EBFn tranh x\xE2m l\u01B0\u1EE3c Vi\u1EC7t Nam n\u0103m 1979, qu\xE2n Trung Qu\u1ED1c r\xFAt v\u1EC1 n\u01B0\u1EDBc, nh\u01B0ng v\u1EABn ti\u1EBFp t\u1EE5c duy tr\xEC \xE1p l\u1EF1c \u1EDF bi\xEAn gi\u1EDBi ph\xEDa B\u1EAFc, li\xEAn ti\u1EBFp b\u1EAFn ph\xE1, \u0111\xE1nh chi\u1EBFm m\u1ED9t s\u1ED1 \u0111\u1ECBa b\xE0n. L\u1EF1c l\u01B0\u1EE3ng v\u0169 trang Vi\u1EC7t Nam t\u1ED5 ch\u1EE9c chi\u1EBFn \u0111\u1EA5u \u0111\xE1nh tr\u1EA3 h\xE0ng tr\u0103m tr\u1EADn ch\u1ED1ng qu\xE2n Trung Qu\u1ED1c l\u1EA5n chi\u1EBFm bi\xEAn gi\u1EDBi c\u1EE7a ph\xEDa B\u1EAFc. \u0110\u1EB7c bi\u1EC7t, \u0111\xE3 \u0111\xE1nh b\u1EADt c\xE1c cu\u1ED9c ti\u1EBFn c\xF4ng l\u1EA5n chi\u1EBFm \u1EDF V\u1ECB Xuy\xEAn, Qu\u1EA3ng Ninh, L\u1EA1ng S\u01A1n, Cao B\u1EB1ng, H\xE0 Giang, bu\u1ED9c Trung Qu\u1ED1c ph\u1EA3i ch\u1EA5m d\u1EE9t c\xE1c ho\u1EA1t \u0111\u1ED9ng ch\u1ED1ng ph\xE1 Vi\u1EC7t Nam \u1EDF bi\xEAn gi\u1EDBi.</size>\r\n\r\n<size=11><i>Having been defeated in the invasion war against Vietnam in 1979, Chinese troops retreated back home, but continued to maintain pressure along the northern border, continuously bombarding and capturing a number of areas. The Vietnamese armed forces fought hundreds of battles against Chinese troops encroaching on these areas. In particular, Vietnamese army repulsed Chinese attacks in Vi Xuyen, Quang Ninh, Lang Son, Cao Bang, and Ha Giang, forcing China to end its military activities against Vietnam at the border.</i></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
